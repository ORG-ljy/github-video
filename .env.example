# SiliconFlow TTS / ASR API Key
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# Personal cloned voice URI (keep private, never commit to public repo)
SILICONFLOW_VOICE_URI=speech:your-voice-name:xxxx:yyyy

# Optional: local path to private assets repository (defaults to ../github-video-private)
PRIVATE_ASSETS_REPO=../github-video-private
